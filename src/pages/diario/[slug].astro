---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Articulo from '../../components/Articulo.astro';

export async function getStaticPaths() {
  const items = await getCollection('noticias', (e) => e.id.startsWith('es/'));
  return items.map((e) => ({ params: { slug: e.id.split('/').pop() }, props: { entry: e } }));
}
const { entry } = Astro.props;
const slug = entry.id.split('/').pop();
---

<Base lang="es" title={`${entry.data.title} · Frutales del Valle de Salazar`} alt={`/eu/diario/${slug}/`}>
  <Articulo entry={entry} lang="es" />
</Base>
