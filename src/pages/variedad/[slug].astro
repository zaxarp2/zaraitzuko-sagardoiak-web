---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ficha from '../../components/Ficha.astro';
import plates from '../../data/plates.json';

export async function getStaticPaths() {
  const items = await getCollection('variedades', (e) => e.id.startsWith('es/'));
  return items.map((e) => ({ params: { slug: e.id.split('/').pop() }, props: { entry: e } }));
}
const { entry } = Astro.props;
const slug = entry.id.split('/').pop();
---

<Base lang="es" title={`${entry.data.name} · Zaraitzuko Sagardoiak`} alt={`/eu/variedad/${slug}/`}>
  <Ficha entry={entry} lang="es" slug={slug} hasPlate={(plates as string[]).includes(slug)} />
</Base>
