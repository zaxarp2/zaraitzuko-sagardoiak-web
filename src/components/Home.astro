---
import { getCollection } from 'astro:content';
import ui from '../i18n/ui.json';
import portada from '../data/portada.json';
import CarruselVariedades from './CarruselVariedades.astro';
import { ordenar } from '../lib/numeros';

interface Props {
  lang: 'es' | 'eu';
}
const { lang } = Astro.props;
const D = (ui as any)[lang];
// Textos de portada editables desde el editor (/admin → Textos de portada)
const P = (portada as any)[lang];
const L = lang === 'eu' ? '/eu' : '';
const diarioBase = lang === 'eu' ? '/eu/diario/' : '/diario/';
const catalogoHref = lang === 'eu' ? '/eu/catalogo/' : '/catalogo/';
const M = D.mail;
const mailto = `mailto:info@zaraitzukosagardoiak.org?subject=${encodeURIComponent(M.subject)}&body=${encodeURIComponent(M.body)}`;
const resumen = (n: any) => n.data.resumen ?? (n.body ?? '').split(/\n\s*\n/)[0].replace(/[*_#>\[\]]|\(\/[^)]*\)/g, '');
// Iconos de los pasos de fotos (trazo fino, estilo grabado)
const ICONS = [
  `<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="24" r="17"/><path d="M32 41v15M26 56h12M32 46l-6-5M32 44l7-6"/></svg>`,
  `<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="22"/><path d="M32 26v12M26 32h12M28 28l8 8M36 28l-8 8"/><circle cx="32" cy="32" r="7"/></svg>`,
  `<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="22"/><circle cx="32" cy="32" r="6"/><path d="M32 32l9-12"/></svg>`,
  `<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="34" cy="24" r="13"/><path d="M34 11l2-5M8 40c8 0 14 4 22 4h14c4 0 4 5 0 5H31M44 44l10-6c4-2 6 3 3 5L41 54H20l-12-4"/></svg>`,
];

const todas = (await getCollection('variedades', (e) => e.id.startsWith(lang + '/'))).sort(ordenar);
const variedades = todas.filter((v) => (v.data.especie ?? 'manzana') === 'manzana');
const peras = todas.filter((v) => v.data.especie === 'pera');
const noticias = (await getCollection('noticias', (e) => e.id.startsWith(lang + '/'))).sort(
  (a, b) => a.data.order - b.data.order
);

// Cifras clave del hero: variedades (dinámico) + informantes / pueblos / muestras ADN (fijos del proyecto)
const stats = (P.inicio.cifras ?? []).map((c: any) => ({ num: c.num, lbl: c.texto }));

---

<!-- ============ HERO ============ -->
<section class="hero" id="inicio">
  <div>
    <div class="hero-eyebrow">{P.inicio.antetitulo}</div>
    <h1 set:html={P.inicio.titulo} />
    <p class="hero-lede">{P.inicio.entradilla}</p>
    <div class="hero-stats">
      {
        stats.map((s) => (
          <div class="hero-stat">
            <div class="num">{s.num}</div>
            <div class="lbl">{s.lbl}</div>
          </div>
        ))
      }
    </div>
  </div>
  <div class="hero-visual">
    <img class="hero-motif" src="/hero-muturbeltz.png" alt="Manzanas Muturbeltz" />
    <div class="hero-caption">Muturbeltz · <span>Malus domestica</span></div>
  </div>
</section>

<!-- ============ MANZANAS ============ -->
<section class="section" id="variedades">
  <div class="section-eyebrow" set:html={D.vars.eyebrow.replace('{n}', String(variedades.length))} />
  <h2 class="section-title" set:html={P.manzanas.titulo} />
  <p class="section-lede">{P.manzanas.entradilla}</p>
  <CarruselVariedades items={variedades} lang={lang} label={D.nav.apples} />
  <div class="vcar-links">
    <a class="btn" href={`${L}/manzanas/`}>{D.vars.verTodas}</a>
    <a class="btn btn-outline" href={catalogoHref}>↓ {D.pdf.catalogo}</a>
  </div>
  <p class="catalogo-nota">{D.pdf.help}</p>
</section>

<!-- ============ PERAS ============ -->
<section class="section" id="peras">
  <div class="section-eyebrow">{D.peras.eyebrow}</div>
  <h2 class="section-title" set:html={P.peras.titulo} />
  <p class="section-lede">{P.peras.entradilla}</p>
  {peras.length > 0 ? (
    <>
      <CarruselVariedades items={peras} lang={lang} label={D.nav.pears} />
      <div class="vcar-links"><a class="btn" href={`${L}/peras/`}>{D.peras.verTodas}</a></div>
    </>
  ) : (
    <p class="peras-vacio">{D.peras.empty}</p>
  )}
</section>

<!-- ============ NOTICIAS / DIARIO ============ -->
<section class="section" id="noticias">
  <div class="section-eyebrow" set:html={D.news.eyebrow} />
  <h2 class="section-title" set:html={P.diario.titulo} />
  <p class="section-lede">{P.diario.entradilla}</p>

  <!-- Mismo formato que manzanas y peras: fila horizontal con flechas y «Ver todas» -->
  <div class="vcar vcar-news" data-vcar>
    <div class="vcar-track" data-vcar-track tabindex="0" aria-label={D.nav.diary}>
      {
        noticias.map((n) => (
          <div class="vcar-item vcar-item-news">
            <a class="news-item" href={`${diarioBase}${n.id.split('/').pop()}/`}>
              <div class="news-date">{n.data.date}</div>
              <h3>{n.data.title}</h3>
              <p>{resumen(n)}</p>
              <span class="news-more">{D.article.more}</span>
              <span class="news-tag">— {n.data.tag}</span>
            </a>
          </div>
        ))
      }
    </div>
    <button class="vcar-btn vcar-prev" type="button" data-vcar-prev aria-label="‹">‹</button>
    <button class="vcar-btn vcar-next" type="button" data-vcar-next aria-label="›">›</button>
  </div>
  <div class="vcar-links"><a class="btn" href={diarioBase}>{D.article.all}</a></div>
</section>

<!-- ============ ASOCIACIÓN ============ -->
<section class="section" id="asociacion">
  <div class="section-eyebrow">{D.assoc.eyebrow}</div>
  <h2 class="section-title" set:html={P.asociacion.titulo} />
  <p class="section-lede">{P.asociacion.entradilla}</p>
  <div class="asoc-grid">
    {(P.asociacion.bloques ?? []).map((x: any) => (
      <div class="asoc-bloque"><h3>{x.titulo}</h3><p>{x.texto}</p></div>
    ))}
  </div>
  <div class="asoc-socio">
    <h3>{P.asociacion.socioTitulo}</h3>
    <p set:html={P.asociacion.socioTexto} />
  </div>
</section>

<!-- ============ COLABORA ============ -->
<section class="section" id="colabora">
  <div class="section-eyebrow">{M.eyebrow}</div>
  <h2 class="section-title" set:html={M.title} />
  <p class="section-lede">{M.lede}</p>

  <h3 class="collab-h">{M.stepsH}</h3>
  <ol class="fotos-pasos">
    {M.steps.map((st: any, i: number) => (
      <li class="paso">
        <span class="paso-icono" set:html={ICONS[i]} />
        <span class="paso-num">{i + 1}</span>
        <strong>{st.h}</strong>
        <span>{st.p}</span>
      </li>
    ))}
  </ol>
  <p class="paso-extra">{M.extra}</p>

  <div class="mail-bloque">
    <div>
      <h3 class="collab-h">{M.dataH}</h3>
      <ul class="mail-datos">
        {M.data.map((x: string) => <li>{x}</li>)}
      </ul>
    </div>
    <div class="mail-accion">
      <a class="btn mail-btn" href={mailto}>✉ {M.btn}</a>
      <p class="mail-nota">{M.note}</p>
      <p class="mail-priv">{M.privacy}</p>
    </div>
  </div>
</section>
