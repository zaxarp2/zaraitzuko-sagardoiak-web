---
import { getCollection, render } from 'astro:content';
import ui from '../i18n/ui.json';

interface Props { entry: any; lang: 'es' | 'eu'; }
const { entry, lang } = Astro.props;
const d = (ui as any)[lang];
const home = lang === 'eu' ? '/eu/' : '/';
const base = lang === 'eu' ? '/eu/diario/' : '/diario/';
const { Content } = await render(entry);
const otras = (await getCollection('noticias', (e) => e.id.startsWith(lang + '/') && e.id !== entry.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<article class="articulo">
  <a class="volver" href={`${home}#noticias`}>← {d.article.back}</a>
  <div class="art-meta">{entry.data.date} · {entry.data.tag}</div>
  <h1>{entry.data.title}</h1>
  {entry.data.resumen && <p class="art-resumen">{entry.data.resumen}</p>}
  <div class="art-cuerpo"><Content /></div>

  {otras.length > 0 && (
    <aside class="art-otras">
      <h2>{d.article.others}</h2>
      <ul>
        {otras.map((o) => (
          <li><a href={`${base}${o.id.split('/').pop()}/`}><span>{o.data.date}</span>{o.data.title}</a></li>
        ))}
      </ul>
    </aside>
  )}
</article>

<style>
  .articulo { max-width: 720px; margin: 0 auto; padding: 120px 6vw 80px; }
  .volver { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rust); text-decoration: none; }
  .art-meta { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--amber); margin: 30px 0 10px; }
  .articulo h1 { font-size: clamp(34px, 6vw, 54px); line-height: 1.05; margin-bottom: 18px; }
  .art-resumen { font-size: 21px; line-height: 1.45; font-style: italic; color: var(--leaf-deep); margin-bottom: 30px; padding-bottom: 26px; border-bottom: 1px solid var(--paper-edge); }
  .art-cuerpo { font-size: 18px; line-height: 1.7; }
  .art-cuerpo :global(p) { margin-bottom: 1.1em; }
  .art-cuerpo :global(h2) { font-size: 26px; margin: 1.6em 0 0.5em; }
  .art-cuerpo :global(h3) { font-size: 20px; margin: 1.2em 0 0.4em; color: var(--rust); }
  .art-cuerpo :global(img) { display: block; max-width: 100%; max-height: 680px; margin: 1.6em auto; box-shadow: 0 8px 30px rgba(31,58,46,0.14); }
  .art-cuerpo :global(ul) { margin: 0 0 1.1em 1.2em; }
  .art-cuerpo :global(li) { margin-bottom: 0.45em; }
  .art-cuerpo :global(a) { color: var(--apple); }
  .art-cuerpo :global(em) { color: var(--stone); }
  .art-otras { margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--paper-edge); }
  .art-otras h2 { font-family: 'JetBrains Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--rust); margin-bottom: 12px; }
  .art-otras ul { list-style: none; }
  .art-otras li { padding: 8px 0; border-bottom: 1px dashed var(--paper-edge); }
  .art-otras a { text-decoration: none; color: var(--ink); font-size: 18px; }
  .art-otras a:hover { color: var(--apple); }
  .art-otras span { display: block; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone); }
  @media (max-width: 720px) { .articulo { padding-top: 96px; } }
</style>
