---
/** Lámina "en preparación" con el mismo marco que las láminas grabadas, para variedades sin foto útil del fruto. */
interface Props { name: string; especie?: string; label: string; }
const { name, especie, label } = Astro.props;
const latin = especie === 'pera' ? 'Pyrus communis' : 'Malus domestica';
---
<div class="lamina-pendiente" role="img" aria-label={`${name} · ${label}`}>
  <div class="lp-head"><span>Tom. I.</span><span>{latin}.</span><span></span></div>
  <div class="lp-frame">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <path d="M 50 22 C 35 22, 26 35, 26 50 C 26 70, 36 82, 50 82 C 64 82, 74 70, 74 50 C 74 35, 65 22, 50 22 Z" fill="none" stroke="currentColor" stroke-width="0.8" stroke-dasharray="2 2.4" />
      <path d="M 45 20 Q 48 12, 54 16" stroke="currentColor" stroke-width="0.8" fill="none" stroke-linecap="round" />
    </svg>
    <p class="lp-label">{label}</p>
  </div>
  <div class="lp-foot"><span>Zaraitzuko Sagardoiak</span><span>Valle de Salazar</span></div>
  <div class="lp-name">{name}.</div>
</div>
<style>
  .lamina-pendiente {
    aspect-ratio: 3 / 4; width: 100%; background: #ede3c9; color: #6b5a44;
    padding: 4.5% 7% 3%; display: flex; flex-direction: column;
    border: 1px solid var(--paper-edge); box-shadow: 0 8px 30px rgba(31,58,46,0.12);
    font-family: 'Fraunces', serif; font-style: italic;
  }
  .lp-head, .lp-foot { display: flex; justify-content: space-between; font-size: 11px; }
  .lp-frame {
    flex: 1; margin: 6px 0; border: 1px solid #8b7a60; outline: 1px solid #b9a888; outline-offset: 3px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
  }
  .lp-frame svg { width: 42%; opacity: 0.55; }
  .lp-label { font-size: 13px; letter-spacing: 0.04em; opacity: 0.8; }
  .lp-foot { font-size: 9px; }
  .lp-name { text-align: center; font-size: 22px; color: #3e2e20; margin-top: 4px; }
</style>
