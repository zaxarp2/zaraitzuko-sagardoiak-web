---
import { getCollection } from 'astro:content';
import ui from '../i18n/ui.json';
import plates from '../data/plates.json';
import { numeros, ordenar, dos } from '../lib/numeros';
import Ficha from './Ficha.astro';

interface Props { lang: 'es' | 'eu'; }
const { lang } = Astro.props;
const d = (ui as any)[lang];
const withPlate = new Set(plates as string[]);
const variedades = (await getCollection('variedades', (e) => e.id.startsWith(lang + '/'))).sort((a, b) => ((a.data.especie ?? 'manzana') === (b.data.especie ?? 'manzana') ? ordenar(a, b) : a.data.especie === 'pera' ? 1 : -1));
const nums = await numeros(lang);
const fecha = new Date().toLocaleDateString(lang === 'eu' ? 'eu-ES' : 'es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="catalogo">
  <div class="cat-portada">
    <div class="cat-marca">
      <svg class="cat-logo" viewBox="0 0 140 110" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M50 40 C38 33 23 40 23 60 C23 80 36 95 50 92 C64 95 77 80 77 60 C77 40 62 33 50 40 Z" />
        <path d="M101 36 C93 36 91 44 91 52 C91 58 84 62 82 74 C80 88 89 96 101 96 C113 96 122 88 120 74 C118 62 111 58 111 52 C111 44 109 36 101 36 Z" />
        <path d="M50 40 C50 32 52 25 57 20 C70 12 88 14 101 26 L101 36" />
        <path class="cat-hoja" d="M76 16 C80 6 93 3 100 5 C96 14 85 19 76 16 Z" />
      </svg>
      <div class="cat-marca-txt">
        <span class="cat-marca-nombre">Zaraitzuko <em>Sagardoiak</em></span>
        <span class="cat-marca-sub">Elkartea</span>
      </div>
      <p class="cat-eyebrow">{d.pdf.catTitle}<br />{d.pdf.catSub}</p>
    </div>
    <img class="cat-motivo" src="/hero-muturbeltz.png" alt="" />
    <div class="cat-titulos">
      <h1>{d.pdf.coverTitle}</h1>
      <p class="cat-sub">{d.pdf.coverSub}</p>
    </div>
    <p class="cat-intro no-print">{d.pdf.catIntro}</p>
    <div class="no-print cat-acciones">
      <button type="button" class="btn" data-imprimir data-preparing={d.pdf.preparing}>↓ {d.pdf.catalogo}</button>
      <p class="ficha-pdf-help">{d.pdf.help}</p>
    </div>
    <p class="cat-pie">Zaraitzuko Sagardoiak Elkartea · {d.pdf.coverAuthor} · {d.pdf.generated} {fecha}</p>
  </div>

  <nav class="cat-indice">
    <h2>{d.pdf.catIndex}</h2>
    <ol>
      {variedades.map((v) => (
        <li><a href={`#ficha-${v.id.split('/').pop()}`}><span>N.º {dos(nums.get(v.id.split('/').pop()))}</span> {v.data.name}</a></li>
      ))}
    </ol>
  </nav>

  {variedades.map((v) => {
    const slug = v.id.split('/').pop()!;
    return (
      <div class="cat-ficha">
        <Ficha entry={v} lang={lang} slug={slug} hasPlate={withPlate.has(slug)} modo="catalogo" />
      </div>
    );
  })}
</div>

<script>
  if (new URLSearchParams(location.search).has('imprimir')) {
    window.addEventListener('load', () => document.querySelector<HTMLButtonElement>('[data-imprimir]')?.click());
  }
</script>

<style>
  .catalogo { padding-top: 90px; }
  .cat-portada { max-width: 860px; margin: 0 auto; padding: 40px 6vw 20px; text-align: center; }
  .cat-marca { display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; color: var(--leaf-deep); }
  .cat-logo { width: 74px; height: auto; }
  .cat-hoja { fill: var(--apple); stroke: var(--apple); }
  .cat-marca-txt { display: flex; flex-direction: column; text-align: left; line-height: 1.05; }
  .cat-marca-nombre { font-family: 'Fraunces', serif; font-size: 22px; }
  .cat-marca-nombre em { color: var(--apple); }
  .cat-marca-sub { font-size: 10px; letter-spacing: 0.32em; text-transform: uppercase; font-weight: 600; }
  .cat-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--rust); flex-basis: 100%; }
  .cat-portada h1 { font-size: clamp(38px, 6vw, 60px); margin: 12px 0 10px; }
  .cat-motivo { width: 70%; max-width: 440px; mix-blend-mode: multiply; margin: 0 auto; display: block; }
  .cat-intro { max-width: 560px; margin: 0 auto 18px; color: var(--stone); }
  .cat-acciones { margin-bottom: 18px; }
  .cat-pie { font-size: 13px; color: var(--stone); font-style: italic; }
  .cat-indice { max-width: 860px; margin: 0 auto; padding: 20px 6vw 10px; }
  .cat-indice h2 { font-family: 'JetBrains Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--rust); border-bottom: 1px solid var(--paper-edge); padding-bottom: 6px; margin-bottom: 10px; }
  .cat-indice ol { list-style: none; columns: 2; column-gap: 40px; }
  .cat-indice li { padding: 3px 0; break-inside: avoid; }
  .cat-indice a { color: var(--ink); text-decoration: none; font-size: 17px; }
  .cat-indice a span { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--amber); margin-right: 8px; }
  .cat-ficha { border-top: 1px solid var(--paper-edge); }
  .cat-sub { max-width: 560px; margin: 0 auto 10px; font-style: italic; color: var(--stone); }
  @media print {
    .catalogo { padding: 0; }
    .cat-portada {
      text-align: left; border-left: 7mm solid #2f7d4a; padding: 6mm 0 0 14mm; margin: 0;
      max-width: none; break-after: page; page-break-after: always;
    }
    .cat-marca { justify-content: flex-start; gap: 4mm; margin: 0 0 4mm; padding-bottom: 5mm; border-bottom: 0.4mm solid #2f7d4a; color: #1f3a2e; }
    .cat-logo { width: 22mm; }
    .cat-marca-nombre { font-size: 15pt; }
    .cat-marca-sub { font-size: 6.5pt; }
    .cat-eyebrow { flex-basis: auto; margin-left: auto; text-align: right; color: #2f7d4a; font-size: 8pt; line-height: 1.5; }
    .cat-motivo { display: block; width: 118mm; margin: 14mm auto 12mm; }
    .cat-titulos { padding-top: 6mm; border-top: 0.4mm solid #2f7d4a; max-width: 150mm; }
    .cat-portada h1 { font-size: 28pt; font-weight: 600; color: #2f7d4a; margin: 0 0 4mm; line-height: 1.08; }
    .cat-sub { margin: 0 0 22mm; font-size: 12pt; max-width: 150mm; }
    .cat-pie { font-size: 9.5pt; }
    .cat-indice { padding: 18mm 0 0; max-width: none; }
    .cat-indice h2 { font-size: 11px; }
    .cat-indice a { font-size: 13pt; }
    .cat-ficha { border: none; break-before: page; page-break-before: always; }
  }
</style>
