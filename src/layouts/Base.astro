---
import ui from '../i18n/ui.json';
import '../styles/global.css';

interface Props {
  lang: 'es' | 'eu';
  title: string;
  /** Misma página en el otro idioma (para el selector ES/EU) */
  alt?: string;
}

const { lang, title, alt } = Astro.props;
const D = (ui as any)[lang];
const isEu = lang === 'eu';
// Rutas base de cada idioma (castellano sin prefijo, euskera bajo /eu/)
const home = isEu ? '/eu/' : '/';
const esHref = isEu ? (alt ?? '/') : '/';
const euHref = isEu ? '/eu/' : (alt ?? '/eu/');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={D.footer.brandB} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="topnav">
      <a class="logo" href={home} aria-label="Zaraitzuko Sagardoiak Elkartea">
        <span class="logo-mark">
          <svg class="logo-svg" viewBox="0 0 140 110" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M50 40 C38 33 23 40 23 60 C23 80 36 95 50 92 C64 95 77 80 77 60 C77 40 62 33 50 40 Z" />
            <path d="M101 36 C93 36 91 44 91 52 C91 58 84 62 82 74 C80 88 89 96 101 96 C113 96 122 88 120 74 C118 62 111 58 111 52 C111 44 109 36 101 36 Z" />
            <path d="M50 40 C50 32 52 25 57 20 C70 12 88 14 101 26 L101 36" />
            <path class="logo-leaf" d="M76 16 C80 6 93 3 100 5 C96 14 85 19 76 16 Z" />
          </svg>
        </span>
        <span class="logo-text">
          <span class="logo-name">Zaraitzuko <em>Sagardoiak</em></span>
          <span class="logo-sub">Elkartea</span>
        </span>
      </a>
      <div class="nav-right">
        <ul class="nav-links">
          <li><a href={`${home}#variedades`}>{D.nav.apples}</a></li>
          <li><a href={`${home}#peras`}>{D.nav.pears}</a></li>
          <li><a href={`${home}#noticias`}>{D.nav.diary}</a></li>
          <li><a href={`${home}#asociacion`}>{D.nav.assoc}</a></li>
          <li><a href={`${home}#colabora`}>{D.nav.collab}</a></li>
        </ul>
        <div class="lang-switch">
          <a
            class:list={['lang-btn', { active: !isEu }]}
            href={esHref}
            aria-current={!isEu ? 'true' : undefined}>ES</a
          >
          <a
            class:list={['lang-btn', { active: isEu }]}
            href={euHref}
            aria-current={isEu ? 'true' : undefined}>EU</a
          >
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-brand">
        <span class="footer-logo">
          <svg class="logo-svg footer-svg" viewBox="0 0 140 110" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M50 40 C38 33 23 40 23 60 C23 80 36 95 50 92 C64 95 77 80 77 60 C77 40 62 33 50 40 Z" />
            <path d="M101 36 C93 36 91 44 91 52 C91 58 84 62 82 74 C80 88 89 96 101 96 C113 96 122 88 120 74 C118 62 111 58 111 52 C111 44 109 36 101 36 Z" />
            <path d="M50 40 C50 32 52 25 57 20 C70 12 88 14 101 26 L101 36" />
            <path class="logo-leaf" d="M76 16 C80 6 93 3 100 5 C96 14 85 19 76 16 Z" />
          </svg>
        </span>
        <h3>{D.footer.brandH}</h3>
        <p>{D.footer.brandB}</p>
      </div>
      <div class="footer-meta">
        <p>{D.footer.author}</p>
        <p>{D.footer.copy}</p>
      </div>
    </footer>
  </body>
</html>
